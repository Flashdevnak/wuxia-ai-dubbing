{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuxia-ai-dubbing",
  "main": "src/worker-stability.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "wuxia-ai-dubbing-files"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "APP_NAME": "ยุทธภพ AI Dubbing",
    "GITHUB_REPO": "Flashdevnak/wuxia-ai-dubbing",
    "TRANSLATE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "TEMP_RETENTION_MINUTES": "30",
    "AFTER_DOWNLOAD_RETENTION_MINUTES": "10",
    "TEMP_STORAGE_BUDGET_GB": "5",
    "R3_SMART_DUBBING": "1"
  }
}
