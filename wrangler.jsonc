{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuxia-ai-dubbing",
  "main": "src/worker-v3.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_NAME": "ยุทธภพ AI Dubbing",
    "GOOGLE_STORAGE_GB": "15",
    "GOOGLE_DRIVE_FOLDER": "Wuxia AI Dubbing",
    "GITHUB_REPO": "Flashdevnak/wuxia-ai-dubbing",
    "TRANSLATE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  }
}
